            else:
                btn.label.set_text(f'Robot {i+1} (Empty)')
                btn.ax.set_facecolor('#ECF0F1')
    
    def add_robot(self, event):
        if len(self.robots) >= 4:
            return
        
        colors = ['#3498DB', '#E74C3C', '#2ECC71', '#F39C12']
        robot_id = f'R{len(self.robots) + 1}'
        
        start_pos = (np.random.uniform(2, self.boundary_width-2),
                    np.random.uniform(2, self.boundary_height-2))
        end_pos = (np.random.uniform(2, self.boundary_width-2),
                  np.random.uniform(2, self.boundary_height-2))
        
        new_robot = {
            'id': robot_id,
            'start': start_pos,
            'end': end_pos,
            'pos': list(start_pos),
            'target_pos': list(start_pos),
            'color': colors[len(self.robots)],
            'path': [],
            'waypoints': [],
            'current_waypoint': 0,
            'total_distance': 0,
            'assigned_jobs': [],
            'kf': KalmanFilter(dt=0.05),
            'moving': False,
            'velocity': [0, 0],
            'speed': 8.0,
            'avoidance_force': [0, 0],
            'safety_radius': 1.5
        }
        new_robot['kf'].set_initial_state(start_pos)
        self.robots.append(new_robot)
        
        self.update_robot_buttons()
        self.draw_all()
        self.update_status()
    
    def remove_robot(self, event):
        if len(self.robots) <= 1:
            return
        
        self.robots.pop(self.selected_robot)
        self.selected_robot = min(self.selected_robot, len(self.robots) - 1)
        
        self.update_robot_buttons()
        self.update_instruction()
        self.draw_all()
        self.update_status()
    
    def set_mode(self, mode):
        self.mode = mode
        self.selected_job_idx = None
        self.selected_obs_idx = None
        self.update_instruction()
    
