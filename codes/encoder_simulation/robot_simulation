        for i, btn in enumerate(self.robot_buttons):
            if i < len(self.robots):
                btn.label.set_text(f'Robot {self.robots[i]["id"]}')
                if i == self.selected_robot:
                    btn.ax.set_facecolor(self.robots[i]['color'])
                else:
