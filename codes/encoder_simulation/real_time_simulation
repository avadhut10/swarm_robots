        self.detector = RealTimeArUcoDetector(
            camera_id=1,
            calibration_file=calibration_file,
            map_file=map_file
        )
        
        self.workspace_width = self.detector.workspace_width_mm
        self.workspace_height = self.detector.workspace_height_mm
        
        self.scale = 0.01
        self.sim_width = self.workspace_width * self.scale
        self.sim_height = self.workspace_height * self.scale
        
        self.robots = []
        self.jobs = []
        self.start_marker = None
        self.end_marker = None
        self.next_job_id = 1
        self.robot_colors = ['#3498DB', '#E74C3C', '#2ECC71', '#F39C12', '#9B59B6', '#1ABC9C']
        
