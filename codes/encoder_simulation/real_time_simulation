    def update_dynamic_markers(self):
        positions = self.detector.get_all_positions()
        
        # Update robots
        new_robot_ids = set(positions['robots'].keys())
        current_robot_ids = {r['marker_id'] for r in self.robots}
        
        for marker_id in new_robot_ids - current_robot_ids:
            pos = positions['robots'][marker_id]
            sim_x = pos[0] * self.scale
            sim_y = pos[1] * self.scale
            robot_num = marker_id - 99
            
            new_robot = {
                'id': f'R{robot_num}',
                'marker_id': marker_id,
                'start': (sim_x, sim_y),
                'end': (sim_x + 1, sim_y + 1),
                'pos': [sim_x, sim_y],
                'target_pos': [sim_x, sim_y],
                'color': self.robot_colors[len(self.robots) % len(self.robot_colors)],
                'path': [],
                'waypoints': [],
                'current_waypoint': 0,
                'total_distance': 0,
                'assigned_jobs': [],
                'kf': KalmanFilter(dt=0.05),
                'moving': False,
                'velocity': [0, 0],
                'speed': 8.0,
                'avoidance_force': [0, 0],
                'safety_radius': 1.5,
                'real_pos_mm': pos
            }
            new_robot['kf'].set_initial_state([sim_x, sim_y])
            self.robots.append(new_robot)
            print(f"✅ New robot detected: ID {marker_id} -> R{robot_num}")
        
        for robot in self.robots[:]:
            if robot['marker_id'] not in new_robot_ids:
                print(f"❌ Robot {robot['id']} (ID {robot['marker_id']}) removed")
                self.robots.remove(robot)
        
        for robot in self.robots:
            if robot['marker_id'] in positions['robots']:
                pos = positions['robots'][robot['marker_id']]
                sim_x = pos[0] * self.scale
                sim_y = pos[1] * self.scale
                robot['real_pos_mm'] = pos
                robot['pos'] = [sim_x, sim_y]
                robot['start'] = (sim_x, sim_y)
                robot['kf'].set_initial_state([sim_x, sim_y])
        
        # Update jobs
        new_job_ids = set(positions['tasks'].keys())
        current_job_ids = {j['marker_id'] for j in self.jobs}
        
        for marker_id in new_job_ids - current_job_ids:
            pos = positions['tasks'][marker_id]
            sim_x = pos[0] * self.scale
            sim_y = pos[1] * self.scale
            
            colors = ['#E74C3C', '#3498DB', '#2ECC71', '#F39C12', '#9B59B6']
            
            new_job = {
                'id': f'J{self.next_job_id}',
                'marker_id': marker_id,
                'pos': (sim_x, sim_y),
                'pos_mm': pos,
                'color': colors[(self.next_job_id - 1) % len(colors)],
                'picked': False,
                'assigned_to': None
            }
            self.jobs.append(new_job)
            self.next_job_id += 1
            print(f"✅ New job detected: ID {marker_id} -> J{self.next_job_id-1}")
        
        for job in self.jobs[:]:
            if job['marker_id'] not in new_job_ids:
                print(f"❌ Job {job['id']} (ID {job['marker_id']}) removed")
                self.jobs.remove(job)
        
        for job in self.jobs:
            if job['marker_id'] in positions['tasks']:
                pos = positions['tasks'][job['marker_id']]
                sim_x = pos[0] * self.scale
                sim_y = pos[1] * self.scale
                job['pos'] = (sim_x, sim_y)
                job['pos_mm'] = pos
        
        # Update START
        if positions['start'] is not None:
            pos = positions['start']
            sim_x = pos[0] * self.scale
            sim_y = pos[1] * self.scale
            self.start_marker = (sim_x, sim_y, pos)
            if not hasattr(self, '_start_detected'):
                print(f"✅ START marker detected at ({pos[0]:.0f}, {pos[1]:.0f})mm")
                self._start_detected = True
        else:
            self.start_marker = None
            if hasattr(self, '_start_detected'):
                print("❌ START marker removed")
                self._start_detected = False
        
        # Update END
        if positions['end'] is not None:
            pos = positions['end']
            sim_x = pos[0] * self.scale
            sim_y = pos[1] * self.scale
            self.end_marker = (sim_x, sim_y, pos)
            if not hasattr(self, '_end_detected'):
                print(f"✅ END marker detected at ({pos[0]:.0f}, {pos[1]:.0f})mm")
                self._end_detected = True
        else:
            self.end_marker = None
