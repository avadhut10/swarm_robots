        self.ax.set_ylim(-2, self.sim_height + 2)
        self.ax.set_aspect('equal')
        self.ax.grid(True, alpha=0.2, linestyle='--')
        self.ax.set_title('DYNAMIC REAL-TIME SIMULATION', 
